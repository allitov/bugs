<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Скорость игры"
            android:textSize="17sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sbGameSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="4" />

        <TextView
            android:id="@+id/tvGameSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0×" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Максимальное количество тараканов"
            android:textSize="17sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sbMaxCockroaches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="45" />

        <TextView
            android:id="@+id/tvMaxCockroaches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Интервал появления бонусов"
            android:textSize="17sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sbBonusInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="55" />

        <TextView
            android:id="@+id/tvBonusInterval"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15 сек" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Длительность раунда"
            android:textSize="17sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sbRoundDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="270" />

        <TextView
            android:id="@+id/tvRoundDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 мин 0 сек" />
    </LinearLayout>
</ScrollView>
